{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": false,
  "redirects": [
    { "source": "/:path*", "has": [{ "type": "host", "value": "tjgroups.com" }], "destination": "https://www.talavishiraajgroups.com/:path*", "permanent": true },
    { "source": "/:path*", "has": [{ "type": "host", "value": "www.tjgroups.com" }], "destination": "https://www.talavishiraajgroups.com/:path*", "permanent": true },
    { "source": "/:path*", "has": [{ "type": "host", "value": "talavishiraajgroups.com" }], "destination": "https://www.talavishiraajgroups.com/:path*", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
      ]
    },
    {
      "source": "/(.*)\\.(png|jpg|jpeg|svg|ico|webp|avif)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }]
    }
  ]
}
