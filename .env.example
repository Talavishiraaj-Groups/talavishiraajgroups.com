# Copy to .env for local development. .env is gitignored.
# Full instructions: BOOKING_SETUP.md and SMTP_SETUP.md

# Booking. Public, baked into the browser bundle at build time.
# The part of your Cal.com link after cal.com/ , e.g. talavishiraaj/intro
VITE_CAL_LINK=

# Server only. Must match the secret set on the Cal.com webhook.
# Generate with: openssl rand -hex 32
CAL_WEBHOOK_SECRET=

# Optional. Defaults to info@talavishiraajgroups.com
BOOKING_NOTIFY_TO=

# Email, see SMTP_SETUP.md
SMTP_USER=
SMTP_PASSWORD=
